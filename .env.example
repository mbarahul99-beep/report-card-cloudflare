# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# CLOUDFLARE D1 DATABASE CREDENTIALS
# Obtain these from your Cloudflare Dashboard (Workers & Pages -> D1 -> Settings / API Tokens)
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_D1_DATABASE_ID="YOUR_CLOUDFLARE_D1_DATABASE_ID"
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"

# GOOGLE OAUTH 2.0 CLIENT ID (Optional for custom Google Cloud OAuth)
VITE_GOOGLE_CLIENT_ID=""

