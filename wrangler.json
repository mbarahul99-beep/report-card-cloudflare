{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "report-card-cloudflare",
  "main": "server.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "report-card-d1",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ],
  "site": {
    "bucket": "./dist"
  }
}
